{
  "name": "shell-is-all-agents-need",
  "version": "1.0.1",
  "description": "Let AI agents work interactively in a shared terminal with humans",
  "type": "module",
  "repository": "github:kyuheon-kr/shell-is-all-agents-need",
  "homepage": "https://github.com/kyuheon-kr/shell-is-all-agents-need#readme",
  "bugs": "https://github.com/kyuheon-kr/shell-is-all-agents-need/issues",
  "files": [
    "bin/",
    "dist/**/*.js",
    "native/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "shell-is-all-agents-need": "bin/shell-is-all-agents-need.js"
  },
  "scripts": {
    "start": "node bin/shell-is-all-agents-need.js",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "test:integration": "node test/integration.ts",
    "test:package": "node test/package.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
